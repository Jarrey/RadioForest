# HTTP service port
HTTP_PORT=18882
HTTPS_PORT=18883
SSL_CERT_PATH=/etc/nginx/ssl/server.crt
SSL_KEY_PATH=/etc/nginx/ssl/server.key

# syncInternetRatio.py 参数
SYNC_COUNTRIES=CN,US,JP,AU,ES,KR,FR,HK,TW,GB,DE,CH,CA,RU,SG,IT,ZA,NZ,BR,MX,AR
SYNC_TARGET_DIR=/var/www/html/playlists
SYNC_BACKUP_DIR=/var/www/html/backup
SYNC_NO_BACKUP=false
SYNC_SHOW_BROKEN=false
SYNC_PAGE_SIZE=500
SYNC_TIMEOUT=120
SYNC_PROXY=false

# Optional HTTP proxy support if enabled by SYNC_PROXY
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

# Optional cron schedule for periodic sync. Leave blank to disable.
# Use standard cron format, e.g. "30 1 * * *" to run daily at 01:30.
SYNC_CRON=30 1 * * *
